# Shared catalog Postgres for compose / VM CD.
# Must honor POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD from compose
# (official image entrypoint). The previous ubuntu+apt image never ran
# docker-entrypoint-initdb.d scripts and ignored those env vars, so
# chinta_user/chinta were never created and notes/platform could not connect.
FROM postgres:16

COPY chinta-db/init.sql /docker-entrypoint-initdb.d/01_init.sql
