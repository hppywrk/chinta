# DEPRECATED: VM deploy uses docker compose (chinta-compose.service).
# Kept for reference only — do not enable on new installs.

[Unit]
Description=Chinta API Gateway [deprecated — use Docker]
After=network-online.target chinta-auth.service
Wants=network-online.target

[Service]
Type=simple
User=chinta
Group=chinta
WorkingDirectory=/opt/chinta/chinta-gateway
EnvironmentFile=-/etc/chinta/deploy.env
ExecStart=/opt/chinta/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8084
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
