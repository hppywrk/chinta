[Unit]
Description=Chinta PostgreSQL (docker compose service chinta-db)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/chinta
EnvironmentFile=-/etc/chinta/deploy.env
ExecStart=/usr/bin/docker compose up -d chinta-db
ExecStop=/usr/bin/docker compose stop chinta-db
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
