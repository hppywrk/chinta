[Unit]
Description=Chinta stack (docker compose)
Documentation=file:///opt/chinta/docker-compose.yml
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/chinta
# Optional: when present, vars are exported into this unit's environment so
# compose can interpolate ${OIDC_*} / ${CHINTA_*}. Do NOT pass a mandatory
# `docker compose --env-file` here — a missing file makes ExecStart fail after
# ExecStop already tore the stack down (vm-deploy restart → all services down).
EnvironmentFile=-/etc/chinta/deploy.env
Environment=CHINTA_DEPLOY_ENV=/etc/chinta/deploy.env
ExecStart=/usr/bin/docker compose up -d chinta-db chinta-auth chinta-backend chinta-gateway chinta-platform
ExecStop=/usr/bin/docker compose stop chinta-db chinta-auth chinta-backend chinta-gateway chinta-platform
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
