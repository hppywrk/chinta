# Copy to repo root as .env for local Docker Compose.
# See docs/LOCAL_DEPLOY_V1.md and docs/PRODUCT_SLICE_V1.md

# --- OIDC (required for real browser login) ---
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Public origin users hit in the browser (gateway)
OIDC_REDIRECT_URI_BASE=http://localhost:8084

# --- Platform / admin CLI ---
CHINTA_PLATFORM_ADMIN_TOKEN=dev-admin-token-change-me

# --- Product UI (planned chinta-ui) ---
CHINTA_COMPANY_NAME=Chinta
CHINTA_DEFAULT_TENANT_SLUG=demo
CHINTA_WEB_URL=http://localhost:8086
CHINTA_UI_URL=http://localhost:8086

# --- Backend / gateway (compose defaults usually fine) ---
CHINTA_ENFORCE_PLATFORM=1
# CHINTA_AUTH_URL=http://chinta-auth:8083
# CHINTA_BACKEND_URL=http://chinta-backend:8080
# CHINTA_PLATFORM_URL=http://chinta-platform:8085
# CHINTA_AUTH_CALLBACK_URL=http://localhost:8084/auth/callback

# --- Observability (planned) ---
CHINTA_LOG_FORMAT=json
CHINTA_LOG_LEVEL=INFO
