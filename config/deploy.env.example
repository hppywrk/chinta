# Copy to /etc/chinta/deploy.env on the VM and adjust values.
# Used by docker compose on deploy (--env-file) and by chinta-auth / chinta-gateway containers.

CHINTA_ROOT=/opt/chinta
CHINTA_DEPLOY_ENV=/etc/chinta/deploy.env

# Default stack for vm-deploy.sh (space-separated compose service names)
# Must include chinta-backend (notes API) and chinta-platform (gateway access resolve).
CHINTA_COMPOSE_SERVICES="chinta-db chinta-auth chinta-backend chinta-gateway chinta-platform"

# Auth (chinta-auth container)
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
# OIDC_ISSUER=https://your-idp.example/
# Public URL users hit for OAuth (gateway or auth, per your routing)
# OIDC_REDIRECT_URI_BASE=https://api.example.com

# Gateway (chinta-gateway container) — use Docker DNS names, not 127.0.0.1
CHINTA_AUTH_URL=http://chinta-auth:8083
CHINTA_BACKEND_URL=http://chinta-backend:8080
CHINTA_PLATFORM_URL=http://chinta-platform:8085
CHINTA_GATEWAY_PORT=8084
# CHINTA_AUTH_CALLBACK_URL=https://api.example.com/auth/callback

# Platform admin API (chinta-platform :8085). Required for chinta-admin; do not
# ship a guessable default — compose publishes this port.
CHINTA_PLATFORM_ADMIN_TOKEN=replace-me
