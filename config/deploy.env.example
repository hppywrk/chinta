# Copy to /etc/chinta/deploy.env on the VM and adjust values.
# Used by systemd units under rootfs/etc/systemd/system/.

# Git checkout root (vm-deploy.sh default)
CHINTA_ROOT=/opt/chinta

# Auth (chinta-auth)
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
# Optional overrides — see chinta-auth/config.py
# OIDC_ISSUER=https://your-idp.example/
# PORT=8083

# Gateway (chinta-gateway)
CHINTA_AUTH_URL=http://127.0.0.1:8083
CHINTA_BACKEND_URL=http://127.0.0.1:8080
CHINTA_GATEWAY_PORT=8084
# CHINTA_WEB_URL=http://127.0.0.1:8000
